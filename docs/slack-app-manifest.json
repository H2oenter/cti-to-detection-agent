{
  "_metadata": {
    "major_version": 2,
    "minor_version": 1
  },
  "display_information": {
    "name": "cti-agent",
    "description": "Runs cti-to-detection-agent from one private channel. Every decision goes through its review gate and audit log."
  },
  "features": {
    "bot_user": {
      "display_name": "cti-agent",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/cti",
        "description": "Run cti-agent",
        "usage_hint": "help | runs | fetch [24h] | prepatch top N | prepatch CVE-… | analyse | review | publish | audit <run>",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "commands",
        "files:read",
        "files:write",
        "groups:history",
        "groups:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "message.groups"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
