# Copy to .env and fill in. .env is gitignored: never commit keys.

ANTHROPIC_API_KEY=
# Only if the key isn't scoped to a workspace: the workspace ID from Console > Settings > Workspaces.
# ANTHROPIC_WORKSPACE_ID=

# Models come from config, not code.
EXTRACT_MODEL=claude-haiku-5-5
ANALYSE_MODEL=claude-sonnet-5-5
REVIEW_MODEL=claude-sonnet-5-5
EXTRACT_EFFORT=medium

# The run stops cleanly before it would exceed this many tokens (input + output).
MAX_TOKENS_PER_RUN=300000

# TLP:AMBER data only goes to an endpoint approved for confidential data.
# TLP:RED never goes to any third-party model, whatever this says.
ENDPOINT_APPROVED_FOR_AMBER=false

# publish --apply only (M3). Use a separate identity from anything that only reads.
# SENTINEL_WORKSPACE_ID=
# PUBLISH_AZURE_TENANT_ID=
# PUBLISH_AZURE_CLIENT_ID=
