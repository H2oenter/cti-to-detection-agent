# Copy to .env and fill in. .env is gitignored: never commit keys.

ANTHROPIC_API_KEY=
# Only if the key isn't scoped to a workspace: the workspace ID from Console > Settings > Workspaces.
# ANTHROPIC_WORKSPACE_ID=

# Models come from config, not code.
EXTRACT_MODEL=claude-haiku-5-5
ANALYSE_MODEL=claude-sonnet-5-5
REVIEW_MODEL=claude-sonnet-5-5
EXTRACT_EFFORT=medium
# Second checks on a different, stronger model. They can only remove or flag, never add.
RECHECK_INDICATORS=true
RECHECK_MODEL=claude-opus-5-5
REVIEW2_MODEL=claude-opus-5-5

# The run stops cleanly before it would exceed this many tokens (input + output).
MAX_TOKENS_PER_RUN=300000

# TLP:AMBER data only goes to an endpoint approved for confidential data.
# TLP:RED never goes to any third-party model, whatever this says.
ENDPOINT_APPROVED_FOR_AMBER=false

# Name written to the audit log for review and publish decisions (default: your OS user).
# CTI_AGENT_REVIEWER=

# publish --apply only. Without --apply, publish is a dry run and needs none of this.
# The publishing identity is the only one with a write role: Microsoft Sentinel Contributor
# on this one workspace, and nothing else. Keep it separate from any identity that only reads.
# Pick one way explicitly; there's no fallback chain:
#   - an app registration: tenant + client ID + a secret or a certificate, or
#   - --use-az-login to publish as yourself after `az login` (the delegated pilot).
# SENTINEL_WORKSPACE_ID=
# PUBLISH_AZURE_TENANT_ID=
# PUBLISH_AZURE_CLIENT_ID=
# PUBLISH_AZURE_CLIENT_SECRET=
# PUBLISH_AZURE_CERTIFICATE_PATH=
